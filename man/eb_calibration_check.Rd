x <- rnorm(n, rnorm(n), s)
fit_prior <- function(x) {            # captures s, not x
  mu  <- mean(x)
  tau <- sqrt(max(var(x) - mean(s^2), 0))
  function(n) rnorm(n, mu, tau)
}
lik <- function(theta) rnorm(length(theta), theta, s)   # i-th theta, i-th s
eb_calibration_check(x, fit_prior, lik)
